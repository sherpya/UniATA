#include <windows.h>
#include "uniata_ver.h"

1 VERSIONINFO
FILEVERSION UNIATA_VER_DOT_COMMA
PRODUCTVERSION UNIATA_VER_DOT_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if DEBUG
FILEFLAGS VS_FF_DEBUG | VS_FF_PRIVATEBUILD
#else
FILEFLAGS VS_FF_PRIVATEBUILD
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DRV
FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AlterWare"
            VALUE "FileDescription", "UniATA XP x86 - experimental MinGW cross build"
            VALUE "FileVersion", UNIATA_VER_DOT_STR
            VALUE "InternalName", "uniata.sys"
            VALUE "OriginalFilename", "uniata.sys"
            VALUE "ProductName", "UniATA"
            VALUE "ProductVersion", "0." UNIATA_VER_STR
            VALUE "PrivateBuild", "Linux/MinGW XP x86 cross build"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

#include "uataerr.rc"
