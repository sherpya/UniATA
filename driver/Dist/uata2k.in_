[Version]
Signature="$Windows NT$"
Provider=%ALTERWARE%
ClassGUID={4D36E97B-E325-11CE-BFC1-08002BE10318}
Class=SCSIAdapter
CatalogFile=uniata.cat
DriverVer=07/04/2004


[DestinationDirs]
DefaultDestDir = 11 ; DIRID_DRIVERS

;
; Driver information
;

[Manufacturer]
%ALTERWARE%=UNIATA_HDC

[UNIATA_HDC]
;DEVLIST
%UniATA_Name% = uniata_Inst

;
; General installation section
;

[uniata_Inst]
AddReg = uniata_Inst.AddReg
CopyFiles = uniata_Inst.Miniport

[uniata_Inst.AddReg]


;
; File sections
;

[uniata_Inst.Miniport]
uniata.sys


;
; Service Installation
;

[uniata_Inst.Services]
AddService = UniATA, 0x00000002, uniata_Service_Inst, uniata_EventLog_Inst

[uniata_Service_Inst]
ServiceType    = 1 ; %SERVICE_KERNEL_DRIVER%
StartType      = 0 ; %SERVICE_BOOT_START%
ErrorControl   = 0 ; %SERVICE_ERROR_NORMAL%
LoadOrderGroup = System Bus Extender
ServiceBinary  = %12%\uniata.sys

AddReg = DISABLE_PCIIDE

[uniata_EventLog_Inst]
AddReg = uniata_EventLog_AddReg

[uniata_EventLog_AddReg]


[DISABLE_PCIIDE]
HKLM, "system\currentcontrolset\services\pciide", "Start", 0x00010001, 0x00000004


;
; Source file information
;

[SourceDisksNames.x86]
1 = %DiskId1%,,,""

[SourceDisksFiles]
; Files for disk Initio Installation Disk #1 (SCSIAdapter)
uniata.sys = 1,,


[Strings]
;DEVNAMELIST
UniATA_Name = "Universal ATA Driver"
ALTERWARE = "AlterWare"

;*******************************************
;
; Non-Localizable Strings
;

REG_SZ         = 0x00000000
REG_MULTI_SZ   = 0x00010000
REG_EXPAND_SZ  = 0x00020000
REG_BINARY     = 0x00000001
REG_DWORD      = 0x00010001
SERVICEROOT    = "System\CurrentControlSet\Services"

DiskId1 = "UniATA Installation disk"

